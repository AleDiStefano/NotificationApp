# Copiá este archivo a ".env" (sin el ".example") y completá los valores.
# El archivo .env NUNCA se sube a git (va en .gitignore) porque tiene credenciales.

# --- Base de datos (usadas por docker-compose.yml) ---
DB_NAME=notificaciones_db
DB_USER=notificaciones_userDEV
DB_PASSWORD=Rosario.123DEV
DB_PORT=5432

# --- Usadas por Spring Boot (application.properties las lee de acá) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/notificaciones_db
DATABASE_USERNAME=notificaciones_user
DATABASE_PASSWORD=cambiame123

# --- JWT (para la autenticación) ---
# Generá un string largo y random, por ejemplo con: openssl rand -base64 32
JWT_SECRET=cambiame-por-un-secreto-largo-y-random
JWT_EXPIRATION_MS=86400000

# --- Email / SMTP (usadas por Spring Boot; por defecto apuntan a MailHog) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@notificacionesapp.local
